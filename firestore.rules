rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow the storefront to read products and allow client-side seed/update operations.
    // This is a temporary fix to make the Shop page display products when no authenticated
    // user is available. Tighten rules later if you want to restrict product writes.
    match /products/{productId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.accountType == 'customer';
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
